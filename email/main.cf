# Configurações essenciais para /etc/postfix/main.cf
myhostname = mail.cardeal.local
mydomain = cardeal.local
myorigin = /etc/mailname
mydestination = cardeal.local, mail.cardeal.local, localhost.localdomain, localhost
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 192.168.10.0/24
home_mailbox = Maildir/
mailbox_size_limit = 0
recipient_delimiter = +
inet_interfaces = all
inet_protocols = ipv4
